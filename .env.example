# Public site origin. Use the exact HTTPS origin in production, without a trailing slash.
APP_ORIGIN=http://localhost:8080
# Development only. Vite also allows its actual local listener origin (including private LAN IP).
# Production ignores this list and requires the exact HTTPS APP_ORIGIN.
APP_DEV_ORIGINS=
# Backend only. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate two independent keys. Encryption: base64 of 32 cryptographically random bytes.
DOCUMENT_ENCRYPTION_KEY=
DATA_HMAC_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Development on localhost/private LAN uses Cloudflare's official test pair by default.
# Set false to use a separate real development widget with authorized hostnames.
# This setting is ignored in production; test credentials are rejected there.
TURNSTILE_LOCAL_TEST_MODE=true
# Set only behind an ingress that overwrites/removes attacker-supplied copies.
# Cloudflare production: cf-connecting-ip. Empty = shared restrictive rate-limit bucket.
TRUSTED_CLIENT_IP_HEADER=
# Edge Functions only. A separate random secret used by your scheduler.
INTEGRATION_WORKER_SECRET=
# Reserved backend secrets. Not consumed until the real adapter is implemented.
LAB_API_BASE_URL=
LAB_API_CREDENTIAL=
LAB_WEBHOOK_SECRET=
